# ---- Variabili d'ambiente ----
# Su Railway queste vanno impostate nella scheda "Variables" del servizio.
# In locale, copia questo file in ".env" e compila i valori.

# Fornita automaticamente da Railway quando colleghi un database Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/gestione

# Chiave segreta per firmare i token di sessione. METTINE UNA LUNGA E CASUALE.
JWT_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Admin iniziale creato al primo avvio (solo se il database è vuoto).
ADMIN_EMAIL=admin@azienda.it
ADMIN_PASSWORD=cambiami

# ---- Email reali (FACOLTATIVO) ----
# Se compili questi campi, le conferme partono davvero via email.
# Se li lasci vuoti, le comunicazioni restano solo dentro l'app.
# Esempio con Gmail: crea una "password per le app" nelle impostazioni Google.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tuoindirizzo@gmail.com
# SMTP_PASS=la-tua-password-per-le-app
# SMTP_FROM=tuoindirizzo@gmail.com
